# Gmail SMTP via Nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@gmail.com
SMTP_APP_PASSWORD=
CONTACT_FROM_EMAIL=your-address@gmail.com
CONTACT_TO_EMAIL=rahandmjaff@gmail.com

# Alternative Gmail STARTTLS configuration:
# SMTP_PORT=587
# SMTP_SECURE=false

# Cloudflare Turnstile (use production widget keys when deploying)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=your-domain.com,www.your-domain.com

# Comma-separated public origins allowed to submit the contact form
CONTACT_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Recommended on serverless deployments for a shared rate limit
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CONTACT_RATE_LIMIT_SALT=replace-with-a-long-random-secret
